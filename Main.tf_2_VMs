terraform {
  required_version = ">= 1.0.0"
  required_providers {
    libvirt = {
      source  = "dmacvicar/libvirt"
      version = "~> 0.7.0"
    }
  }
}

provider "libvirt" {
  uri = "qemu:///system"
}

# Imagem Cloud Base compartilhada (Ubuntu 22.04)
resource "libvirt_volume" "ubuntu_base" {
  name   = "ubuntu-22.04-base.qcow2"
  pool   = "default"
  source = "https://cloud-images.ubuntu.com/releases/22.04/release/ubuntu-22.04-server-cloudimg-amd64.img"
  format = "qcow2"
}

# Discos individuais para cada nó (20 GB cada)
resource "libvirt_volume" "vm_disk" {
  count          = 2
  name           = "k8s-node-${count.index + 1}-disk.qcow2"
  base_volume_id = libvirt_volume.ubuntu_base.id
  pool           = "default"
  size           = 21474836480 # 20 GB
}

# Discos Cloud-Init individuais (para hostnames distintos)
resource "libvirt_cloudinit_disk" "vm_init" {
  count = 2
  name  = "k8s-node-${count.index + 1}-init.iso"
  pool  = "default"
  user_data = <<-EOF
#cloud-config
hostname: k8s-node-${count.index + 1}
fqdn: k8s-node-${count.index + 1}.local
manage_etc_hosts: true
users:
  - name: ubuntu
    password: ifes@123
    chpasswd: { expire: False }
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: users, admin
    home: /home/ubuntu
    shell: /bin/bash
    ssh_authorized_keys:
      - ${trimspace(file(pathexpand("~/.ssh/id_rsa.pub")))}
ssh_pwauth: true
disable_root: false
EOF
}

# Rede NAT dedicada (192.168.100.0/24)
resource "libvirt_network" "cluster_net" {
  name      = "qemu_cluster_net"
  mode      = "nat"
  domain    = "k8s.local"
  addresses = ["192.168.100.0/24"]
  autostart = true
  dhcp {
    enabled = true
  }
  dns {
    enabled = true
  }
}

# Definição das duas VMs
resource "libvirt_domain" "k8s_node" {
  count     = 2
  name      = "k8s-node-${count.index + 1}"
  memory    = 4096
  vcpu      = 2
  cloudinit = libvirt_cloudinit_disk.vm_init[count.index].id

  type    = "qemu"
  machine = "pc"

  network_interface {
    network_id     = libvirt_network.cluster_net.id
    wait_for_lease = true
  }

  disk {
    volume_id = libvirt_volume.vm_disk[count.index].id
  }

  console {
    type        = "pty"
    target_port = "0"
    target_type = "serial"
  }

  graphics {
    type        = "spice"
    listen_type = "address"
    autoport    = true
  }
}

# Saída com o IP de cada máquina
output "nodes_ip" {
  value = {
    for idx, vm in libvirt_domain.k8s_node :
    vm.name => vm.network_interface[0].addresses[0]
  }
  des
